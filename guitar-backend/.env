# Copy to .env and fill in values. Never commit .env to git.

PORT=8080
ENVIRONMENT=development

# Postgres — point at PgBouncer in production
DATABASE_URL=postgres://guitar:guitar_secret@localhost:5432/guitar_dev
APP_DATABASE_URL=postgres://guitar:guitar_secret@localhost:6432/guitar_dev
DB_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# JWT — use a long random string in production: openssl rand -hex 64
JWT_SECRET=b1173cc29c236ee5021d658872a78322064ef79357e879105a612ecd7cad09ec
JWT_EXPIRY_SECS=86400
REFRESH_TOKEN_EXPIRY_SECS=2592000

# Cloudflare R2 (or AWS S3)
S3_BUCKET=guitar-recordings
S3_REGION=auto
# For R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For S3: leave empty
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI service
AI_SERVICE_URL=http://localhost:9000
AI_SERVICE_KEY=

# Rate limiting
RATE_LIMIT_RPS=60
